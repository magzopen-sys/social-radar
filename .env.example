# Copy this file to ".env" (same folder) and fill in your keys.
# .env is git-ignored — it stays on your Mac and is NEVER pushed.
#   cp .env.example .env    then edit .env

# --- Reddit (official API; create a "script" app at reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-radar/1.0 (by /u/your_username)

# --- YouTube (free key: Google Cloud Console -> YouTube Data API v3) ---
YOUTUBE_API_KEY=

# --- TikTok (official Research API; only works if your app is APPROVED for it;
#     otherwise the Mac browser scraper is used automatically) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_HASHTAGS=minecraft,minecraftbuilds

# --- Optional tuning (sensible defaults exist for all of these) ---
# REDDIT_SUBS=Minecraft,MinecraftMemes,youtubeshorts,Minecraftbuilds,redstone,technicalminecraft
# REDDIT_MIN_SCORE=100
# REDDIT_LIMIT=50
# YOUTUBE_QUERIES=minecraft,minecraft shorts,minecraft build hacks
# YOUTUBE_LIMIT=50
# GEO=US
